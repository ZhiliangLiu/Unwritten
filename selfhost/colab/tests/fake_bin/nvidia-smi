#!/usr/bin/env python3
import os
from pathlib import Path
import sys

log_path = os.environ.get("FAKE_BIN_LOG")
if log_path:
    with Path(log_path).open("a") as log:
        log.write("command=nvidia-smi\n")
        for argument in sys.argv[1:]:
            log.write(argument + "\n")
print(os.environ.get("FAKE_NVIDIA_SMI_MIB", "24576"))
