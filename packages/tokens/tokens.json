{
  "$description": "Unwritten 设计 token 的单源，格式为 DTCG 2025.10。名字规则、分组和各客户端的生成方式见 docs/theme.md §2–3。",
  "$extensions": {
    "unwritten": {
      "units": "带 unit: em 的 number 是相对当前字号的倍数",
      "zero-duration": "时长为 0 的过渡和动画表示不播放"
    }
  },
  "base": {
    "font": {
      "ui": {
        "$type": "fontFamily",
        "$value": ["system-ui", "-apple-system", "PingFang SC", "Microsoft YaHei UI", "Noto Sans CJK SC", "sans-serif"]
      },
      "prose-serif": {
        "$type": "fontFamily",
        "$value": ["Songti SC", "Source Han Serif SC", "Noto Serif CJK SC", "serif"]
      },
      "prose-sans": {
        "$type": "fontFamily",
        "$value": "{base.font.ui}"
      },
      "mono": {
        "$type": "fontFamily",
        "$value": ["ui-monospace", "SF Mono", "Menlo", "Consolas", "monospace"]
      }
    },
    "text": {
      "xs": {
        "$type": "dimension",
        "$value": { "value": 0.75, "unit": "rem" }
      },
      "sm": {
        "$type": "dimension",
        "$value": { "value": 0.8125, "unit": "rem" }
      },
      "md": {
        "$type": "dimension",
        "$value": { "value": 0.875, "unit": "rem" }
      },
      "lg": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "rem" }
      },
      "xl": {
        "$type": "dimension",
        "$value": { "value": 1.25, "unit": "rem" }
      },
      "2xl": {
        "$type": "dimension",
        "$value": { "value": 1.5, "unit": "rem" }
      },
      "3xl": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "rem" }
      }
    },
    "leading": {
      "tight": {
        "$type": "number",
        "$value": 1.25
      },
      "ui": {
        "$type": "number",
        "$value": 1.5
      },
      "prose": {
        "$type": "number",
        "$value": 1.85
      },
      "prose-compact": {
        "$type": "number",
        "$value": 1.65
      }
    },
    "weight": {
      "regular": {
        "$type": "fontWeight",
        "$value": 400
      },
      "medium": {
        "$type": "fontWeight",
        "$value": 500
      },
      "semibold": {
        "$type": "fontWeight",
        "$value": 600
      }
    },
    "tracking": {
      "tight": {
        "$type": "number",
        "$value": -0.01,
        "$extensions": {
          "unwritten": {
            "unit": "em"
          }
        }
      },
      "normal": {
        "$type": "number",
        "$value": 0,
        "$extensions": {
          "unwritten": {
            "unit": "em"
          }
        }
      }
    },
    "typography": {
      "page-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.2xl}",
          "fontWeight": "{base.weight.semibold}",
          "letterSpacing": { "value": -0.015, "unit": "rem" },
          "lineHeight": "{base.leading.tight}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.tight}"
          }
        }
      },
      "section-title": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.lg}",
          "fontWeight": "{base.weight.semibold}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.tight}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      },
      "subtitle": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.md}",
          "fontWeight": "{base.weight.semibold}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.ui}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      },
      "body": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.md}",
          "fontWeight": "{base.weight.regular}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.ui}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      },
      "caption": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.sm}",
          "fontWeight": "{base.weight.regular}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.ui}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      },
      "label": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.ui}",
          "fontSize": "{base.text.xs}",
          "fontWeight": "{base.weight.medium}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.ui}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      },
      "mono": {
        "$type": "typography",
        "$value": {
          "fontFamily": "{base.font.mono}",
          "fontSize": "{base.text.sm}",
          "fontWeight": "{base.weight.regular}",
          "letterSpacing": { "value": 0, "unit": "px" },
          "lineHeight": "{base.leading.ui}"
        },
        "$extensions": {
          "unwritten": {
            "tracking": "{base.tracking.normal}"
          }
        }
      }
    },
    "prose": {
      "font": {
        "$type": "fontFamily",
        "$value": "{base.font.prose-serif}",
        "$extensions": {
          "unwritten": {
            "preference": "prose-font",
            "options": {
              "serif": "{base.font.prose-serif}",
              "sans": "{base.font.prose-sans}"
            }
          }
        }
      },
      "size": {
        "$type": "dimension",
        "$value": "{base.prose.size-scale.3}",
        "$extensions": {
          "unwritten": {
            "preference": "prose-size",
            "options": {
              "1": "{base.prose.size-scale.1}",
              "2": "{base.prose.size-scale.2}",
              "3": "{base.prose.size-scale.3}",
              "4": "{base.prose.size-scale.4}",
              "5": "{base.prose.size-scale.5}"
            }
          }
        }
      },
      "size-scale": {
        "1": {
          "$type": "dimension",
          "$value": { "value": 1, "unit": "rem" }
        },
        "2": {
          "$type": "dimension",
          "$value": { "value": 1.0625, "unit": "rem" }
        },
        "3": {
          "$type": "dimension",
          "$value": { "value": 1.125, "unit": "rem" }
        },
        "4": {
          "$type": "dimension",
          "$value": { "value": 1.25, "unit": "rem" }
        },
        "5": {
          "$type": "dimension",
          "$value": { "value": 1.375, "unit": "rem" }
        }
      },
      "leading": {
        "$type": "number",
        "$value": "{base.leading.prose}",
        "$extensions": {
          "unwritten": {
            "preference": "prose-leading",
            "options": {
              "comfortable": "{base.leading.prose}",
              "compact": "{base.leading.prose-compact}"
            }
          }
        }
      },
      "measure": {
        "$type": "number",
        "$value": 36,
        "$extensions": {
          "unwritten": {
            "unit": "em"
          }
        }
      },
      "page-ratio": {
        "$type": "number",
        "$value": 0.64
      },
      "paragraph-gap": {
        "$type": "number",
        "$value": 0.9,
        "$extensions": {
          "unwritten": {
            "unit": "em"
          }
        }
      },
      "indent": {
        "$type": "number",
        "$value": 2,
        "$extensions": {
          "unwritten": {
            "unit": "em",
            "preference": "prose-indent",
            "options": {
              "2": 2,
              "0": 0
            }
          }
        }
      },
      "action-size": {
        "$type": "number",
        "$value": 0.9,
        "$extensions": {
          "unwritten": {
            "unit": "em"
          }
        }
      }
    },
    "space": {
      "1": {
        "$type": "dimension",
        "$value": { "value": 0.25, "unit": "rem" }
      },
      "2": {
        "$type": "dimension",
        "$value": { "value": 0.5, "unit": "rem" }
      },
      "3": {
        "$type": "dimension",
        "$value": { "value": 0.75, "unit": "rem" }
      },
      "4": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "rem" }
      },
      "5": {
        "$type": "dimension",
        "$value": { "value": 1.25, "unit": "rem" }
      },
      "6": {
        "$type": "dimension",
        "$value": { "value": 1.5, "unit": "rem" }
      },
      "8": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "rem" }
      },
      "10": {
        "$type": "dimension",
        "$value": { "value": 2.5, "unit": "rem" }
      },
      "12": {
        "$type": "dimension",
        "$value": { "value": 3, "unit": "rem" }
      },
      "16": {
        "$type": "dimension",
        "$value": { "value": 4, "unit": "rem" }
      }
    },
    "radius": {
      "sm": {
        "$type": "dimension",
        "$value": { "value": 0.25, "unit": "rem" }
      },
      "md": {
        "$type": "dimension",
        "$value": { "value": 0.375, "unit": "rem" }
      },
      "lg": {
        "$type": "dimension",
        "$value": { "value": 0.625, "unit": "rem" }
      },
      "full": {
        "$type": "dimension",
        "$value": { "value": 9999, "unit": "px" }
      }
    },
    "border": {
      "width": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "px" }
      }
    },
    "focus-ring": {
      "width": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "px" }
      },
      "offset": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "px" }
      }
    },
    "size": {
      "icon-sm": {
        "$type": "dimension",
        "$value": { "value": 1, "unit": "rem" }
      },
      "icon-md": {
        "$type": "dimension",
        "$value": { "value": 1.25, "unit": "rem" }
      },
      "icon-stroke": {
        "$type": "number",
        "$value": 1.75,
        "$description": "按 24 单位的图标画布计，随图标尺寸等比缩放"
      },
      "control-sm": {
        "$type": "dimension",
        "$value": { "value": 1.75, "unit": "rem" }
      },
      "control-md": {
        "$type": "dimension",
        "$value": { "value": 2, "unit": "rem" }
      },
      "control-lg": {
        "$type": "dimension",
        "$value": { "value": 2.5, "unit": "rem" }
      },
      "target-min": {
        "$type": "dimension",
        "$value": { "value": 1.5, "unit": "rem" }
      },
      "meter": {
        "$type": "dimension",
        "$value": { "value": 0.25, "unit": "rem" }
      },
      "toolbar": {
        "$type": "dimension",
        "$value": { "value": 3, "unit": "rem" }
      },
      "panel": {
        "$type": "dimension",
        "$value": { "value": 22.5, "unit": "rem" }
      },
      "panel-min": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "rem" }
      },
      "panel-max": {
        "$type": "dimension",
        "$value": { "value": 35, "unit": "rem" }
      },
      "panel-ratio": {
        "$type": "number",
        "$value": 0.32
      },
      "page-max": {
        "$type": "dimension",
        "$value": { "value": 75, "unit": "rem" }
      },
      "card-min": {
        "$type": "dimension",
        "$value": { "value": 20, "unit": "rem" }
      }
    },
    "z": {
      "sticky": {
        "$type": "number",
        "$value": 10
      },
      "overlay": {
        "$type": "number",
        "$value": 100
      },
      "popover": {
        "$type": "number",
        "$value": 200
      },
      "toast": {
        "$type": "number",
        "$value": 300
      },
      "tooltip": {
        "$type": "number",
        "$value": 400
      }
    },
    "opacity": {
      "disabled": {
        "$type": "number",
        "$value": 0.45
      },
      "muted": {
        "$type": "number",
        "$value": 0.7
      }
    },
    "breakpoint": {
      "compact": {
        "$type": "dimension",
        "$value": { "value": 48, "unit": "rem" },
        "$extensions": {
          "unwritten": {
            "media": "width < value"
          }
        }
      },
      "wide": {
        "$type": "dimension",
        "$value": { "value": 80, "unit": "rem" },
        "$extensions": {
          "unwritten": {
            "media": "width >= value"
          }
        }
      }
    },
    "motion": {
      "duration-fast": {
        "$type": "duration",
        "$value": { "value": 120, "unit": "ms" }
      },
      "duration-base": {
        "$type": "duration",
        "$value": { "value": 200, "unit": "ms" }
      },
      "duration-slow": {
        "$type": "duration",
        "$value": { "value": 280, "unit": "ms" }
      },
      "duration-reading": {
        "$type": "duration",
        "$value": { "value": 360, "unit": "ms" }
      },
      "duration-theme": {
        "$type": "duration",
        "$value": { "value": 240, "unit": "ms" }
      },
      "duration-highlight": {
        "$type": "duration",
        "$value": { "value": 1200, "unit": "ms" }
      },
      "duration-pulse": {
        "$type": "duration",
        "$value": { "value": 1600, "unit": "ms" }
      },
      "duration-spin": {
        "$type": "duration",
        "$value": { "value": 800, "unit": "ms" }
      },
      "delay-tooltip": {
        "$type": "duration",
        "$value": { "value": 500, "unit": "ms" }
      },
      "delay-stagger": {
        "$type": "duration",
        "$value": { "value": 80, "unit": "ms" }
      },
      "ease-standard": {
        "$type": "cubicBezier",
        "$value": [0.2, 0, 0, 1]
      },
      "ease-enter": {
        "$type": "cubicBezier",
        "$value": [0, 0, 0.2, 1]
      },
      "ease-exit": {
        "$type": "cubicBezier",
        "$value": [0.4, 0, 1, 1]
      },
      "ease-linear": {
        "$type": "cubicBezier",
        "$value": [0, 0, 1, 1]
      },
      "distance-sm": {
        "$type": "dimension",
        "$value": { "value": 4, "unit": "px" }
      },
      "distance-md": {
        "$type": "dimension",
        "$value": { "value": 8, "unit": "px" }
      },
      "scale-enter": {
        "$type": "number",
        "$value": 0.97
      },
      "scale-press": {
        "$type": "number",
        "$value": 0.98
      }
    },
    "transition": {
      "feedback": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-fast}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-standard}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["color", "background-color", "border-color"]
          }
        }
      },
      "press": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-fast}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-standard}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["transform"]
          }
        }
      },
      "popup": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-base}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-enter}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity", "transform"]
          }
        }
      },
      "popup-exit": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-base}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-exit}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity", "transform"]
          }
        }
      },
      "dialog": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-slow}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-enter}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity", "transform"]
          }
        }
      },
      "dialog-exit": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-slow}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-exit}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity", "transform"]
          }
        }
      },
      "panel": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-slow}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-standard}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["inline-size"]
          }
        }
      },
      "reading": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-reading}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-enter}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity", "transform"]
          }
        }
      }
    },
    "animation": {
      "pulse": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-pulse}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-linear}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["opacity"],
            "iteration": "infinite"
          }
        }
      },
      "spin": {
        "$type": "transition",
        "$value": {
          "duration": "{base.motion.duration-spin}",
          "delay": { "value": 0, "unit": "ms" },
          "timingFunction": "{base.motion.ease-linear}"
        },
        "$extensions": {
          "unwritten": {
            "properties": ["transform"],
            "iteration": "infinite"
          }
        }
      }
    }
  },
  "theme": {
    "light": {
      "$extensions": {
        "unwritten": {
          "color-scheme": "light"
        }
      },
      "color": {
        "bg": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9569, 0.949, 0.9294],
            "hex": "#f4f2ed"
          }
        },
        "surface": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9843, 0.9804, 0.9686],
            "hex": "#fbfaf7"
          }
        },
        "surface-raised": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "hex": "#ffffff"
          }
        },
        "surface-sunken": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9333, 0.9216, 0.898],
            "hex": "#eeebe5"
          }
        },
        "surface-hover": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9412, 0.9294, 0.9059],
            "hex": "#f0ede7"
          }
        },
        "surface-pressed": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.9098, 0.8941, 0.8667],
            "hex": "#e8e4dd"
          }
        },
        "surface-selected": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8941, 0.9137, 0.9412],
            "hex": "#e4e9f0"
          }
        },
        "text": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.149, 0.1333, 0.1137],
            "hex": "#26221d"
          }
        },
        "text-muted": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.3725, 0.3451, 0.3098],
            "hex": "#5f584f"
          }
        },
        "text-subtle": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5333, 0.502, 0.4549],
            "hex": "#888074"
          }
        },
        "text-on-accent": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [1.0, 1.0, 1.0],
            "hex": "#ffffff"
          }
        },
        "border": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.8902, 0.8706, 0.8353],
            "hex": "#e3ded5"
          }
        },
        "border-control": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.5216, 0.4863, 0.4392],
            "hex": "#857c70"
          }
        },
        "accent": {
          "$type": "color",
          "$value": {
            "colorSpace": "srgb",
            "components": [0.2314, 0.3451, 0.4706],
            "hex": "#3b5878"
          }
        },
        "accent-hover": {
