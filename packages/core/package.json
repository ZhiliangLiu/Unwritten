{
  "name": "@unwritten/core",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "dev": "node --watch src/main.ts --data-dir ../../.data --port 4317 --client-origin http://localhost:5173 --log-level debug",
    "start": "node dist/main.js --data-dir ../../.data",
    "build": "tsdown",
    "typecheck": "tsc --noEmit",
    "test": "vitest run --passWithNoTests",
    "db:generate": "drizzle-kit generate"
  },
  "dependencies": {
    "@earendil-works/pi-agent-core": "catalog:",
    "@earendil-works/pi-ai": "catalog:",
    "@hono/node-server": "catalog:",
    "@orpc/contract": "catalog:",
    "@orpc/server": "catalog:",
    "@unwritten/contracts": "workspace:*",
    "drizzle-orm": "catalog:",
    "hono": "catalog:",
    "p-queue": "catalog:",
    "zod": "catalog:"
  },
  "devDependencies": {
    "@orpc/client": "catalog:",
    "@types/node": "catalog:",
    "drizzle-kit": "catalog:",
    "tsdown": "catalog:",
    "typescript": "catalog:",
    "vitest": "catalog:"
  }
}
