{
  "name": "unwritten",
  "private": true,
  "type": "module",
  "packageManager": "pnpm@12.21.0",
  "engines": {
    "node": ">=24"
  },
  "scripts": {
    "build": "turbo run build",
    "typecheck": "turbo run typecheck",
    "lint": "oxlint --type-aware && stylelint \"apps/client/src/**/*.css\" --allow-empty-input",
    "test": "node scripts/check-tokens.mjs && node --test packages/tokens/build-css.test.mjs scripts/dev.test.mjs && turbo run test",
    "e2e": "turbo run build && pnpm --filter @unwritten/e2e e2e",
    "format": "prettier --write apps packages e2e scripts \"*.json\" \"*.mjs\"",
    "format:check": "prettier --check apps packages e2e scripts \"*.json\" \"*.mjs\"",
    "check:docs": "node scripts/check-doc-links.mjs",
    "app": "node scripts/app.mjs",
    "dev": "node scripts/dev.mjs",
    "dev:core": "pnpm --filter @unwritten/core dev",
    "dev:client": "pnpm --filter @unwritten/client dev",
    "prepare": "lefthook install"
  },
  "devDependencies": {
    "@types/node": "catalog:",
    "eslint-plugin-i18next": "catalog:",
    "eslint-plugin-react-hooks": "catalog:",
    "lefthook": "catalog:",
    "oxlint": "catalog:",
    "oxlint-tsgolint": "catalog:",
    "prettier": "catalog:",
    "stylelint": "catalog:",
    "stylelint-config-standard": "catalog:",
    "stylelint-declaration-strict-value": "catalog:",
    "stylelint-use-logical": "catalog:",
    "turbo": "catalog:",
    "typescript": "catalog:"
  }
}
